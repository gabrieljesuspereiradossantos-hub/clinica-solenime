# Copie para .env.local (não vai para o git) e preencha.

# Google Places: nota e avaliações AO VIVO na home.
# A chave vai para o navegador, então no Google Cloud Console restrinja:
#   - Restrições de aplicativo: Referenciadores HTTP -> https://SEU-DOMINIO/*  e  http://localhost:5173/*
#   - Restrições de API: "Maps JavaScript API" e "Places API (New)"
VITE_GOOGLE_MAPS_API_KEY=

# Place ID do perfil "Clinica Solenime Estética" (começa com ChIJ...).
# Descubra com:  GOOGLE_PLACES_SERVER_KEY=... npm run place-id
# ou no Place ID Finder: https://developers.google.com/maps/documentation/places/web-service/place-id
VITE_GOOGLE_PLACE_ID=

# Domínio final do site, sem barra no fim (ex.: https://clinicasolenime.com.br). Também vai em .env
VITE_SITE_URL=

# Nano Banana (imagens com Gemini). Crie em https://aistudio.google.com/apikey e coloque em .env.local (nunca no git).
# Uso: npm run imagem -- "descrição". Imagens de IA nunca como foto da clínica, equipe, paciente ou resultado.
GEMINI_API_KEY=
